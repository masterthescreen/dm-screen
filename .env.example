# --- MySQL (shared data store) ---
# On GoDaddy Node.js Hosting, create a managed MySQL database in your dashboard
# and copy its connection details here. Set these as environment variables /
# secrets in the hosting panel. Do not commit a real .env file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=codex

# --- Security ---
# REQUIRED in production for first-time setup. A secret word only you know.
# Visitors must enter it to create the GM account, so a stranger who finds the
# site before you can't claim it. You can remove it after setup if you like.
GM_SETUP_CODE=

# Optional. At least 32 random characters. Signs login sessions. If you leave
# it empty, one is generated and stored in the database automatically.
SESSION_SECRET=
