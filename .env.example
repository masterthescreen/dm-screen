# MySQL connection for the shared GM/player data store.
# On GoDaddy Node.js Hosting, create a managed MySQL database in your
# dashboard and copy its connection details here (set these as environment
# variables / secrets in the hosting panel — do not commit a real .env file).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=codex
